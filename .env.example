# Bright Data Scraper Studio (leave any required value blank for safe mock mode)
# Get a real c_* collector ID only by creating it yourself:
#   docs/statbunker-live-runbook.md + scrapers/statbunker/create-prompt.txt
# This file never ships a real collector ID, token, or operator secret.
# Render sets PORT automatically. Set HOST=0.0.0.0 on the backend service and
# list the deployed frontend origin(s), comma-separated, without URL paths.
HOST=127.0.0.1
CARDPULSE_ALLOWED_ORIGINS=

BRIGHT_DATA_API_TOKEN=
BRIGHT_DATA_COLLECTOR_ID=
BRIGHT_DATA_TARGET_URL=http://127.0.0.1:4311/players
CARDPULSE_SOURCE_ID=openligadb-football-demo
CARDPULSE_SOURCE_PROFILE=

# Verified Premier League season registry (searchable card generator).
# Only these seasons are selectable; anything else fails closed. Target URLs
# are public list pages of the shape:
#   https://www.statbunker.com/competitions/PlayerStandings?comp_id=<id>
#   2023/24 -> comp_id=745
#   2024/25 -> comp_id=596
#   2025/26 -> comp_id=776 (season used by the existing evidence trail)
#   2026/27 -> comp_id=791 (current season; incomplete — match data may be partial)
#
# For a StatBunker live run instead of the local demo target, set
# BRIGHT_DATA_TARGET_URL to exactly ONE registry page above,
# CARDPULSE_SOURCE_ID to statbunker-epl-<year-range> for that page, and
# CARDPULSE_SOURCE_PROFILE=statbunker. Public reachability is not a license:
# keep a low request rate, run manually only, and stop on 403/429.

# Live collection/healing mutations are denied unless both controls are set.
CARDPULSE_ENABLE_LIVE_MUTATIONS=false
# Generate a private random value with at least 32 characters. Never commit it.
CARDPULSE_OPERATOR_TOKEN=
